{
  "ConnectionStrings": {
    "Default": "Data Source=retailpayments.db"
  },
  "Import": {
    "FinalizeAfterHours": 24,
    "SourceTimeoutSeconds": 30
  },
  "Sources": {
    "Mode": "Json",
    "Json": {
      "Folder": "SampleData",
      "Files": [ "step0.json", "step1.json", "step2.json", "step3.json" ],
      "SourceSystems": [ "Store Uptown", "Store Downtown", "Online" ]
    }
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/retailpayments-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
